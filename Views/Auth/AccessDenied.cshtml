@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<section class="auth-card" style="max-width:540px; margin:40px auto; text-align:center;">
    <h1 style="color:var(--flaw); margin-bottom:12px;">Truy cập bị từ chối</h1>
    <p class="muted">Bạn không có quyền thực hiện thao tác hoặc truy cập vào trang này. Hãy đăng nhập bằng tài khoản Quản trị viên (Admin) nếu đây là khu vực quản trị.</p>
    <div class="row" style="justify-content:center; gap:12px; margin-top:20px;">
        <a class="btn" asp-controller="Products" asp-action="Index">Về trang chủ</a>
        <a class="btn-ghost" asp-controller="Auth" asp-action="Login">Đăng nhập tài khoản khác</a>
    </div>
</section>
