@model RegisterRequest
@{
    ViewData["Title"] = "Đăng ký thành viên";
}

<div class="form-card" style="max-width:460px; margin:40px auto;">
    <div class="form-header text-center">
        <span class="hero-tag">GIA NHẬP CỘNG ĐỒNG</span>
        <h1 class="form-title" style="margin-top:4px;">Tạo tài khoản</h1>
        <p class="form-subtitle">Chia sẻ trải nghiệm thực tế và đóng góp đánh giá khách quan.</p>
    </div>

    <form class="form" asp-controller="Auth" asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="panel" style="background:#fef2f2; color:#b91c1c; padding:10px; margin-bottom:14px; border-radius:8px;"></div>

        <div class="form-group">
            <label class="form-label">Họ và tên hiển thị <span class="req">(*)</span></label>
            <input class="form-control" asp-for="FullName" required minlength="2" maxlength="150" placeholder="VD: Nguyễn Thị Nguyệt Hà" />
            <span asp-validation-for="FullName" style="color:var(--cons); font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Địa chỉ Email <span class="req">(*)</span></label>
            <input class="form-control" asp-for="Email" type="email" required placeholder="name@domain.com" />
            <span asp-validation-for="Email" style="color:var(--cons); font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Mật khẩu <span class="req">(*)</span></label>
            <input class="form-control" asp-for="Password" type="password" required minlength="6" placeholder="Tối thiểu 6 ký tự" />
            <span asp-validation-for="Password" style="color:var(--cons); font-size:12px;"></span>
        </div>

        <button class="btn" type="submit" style="width:100%; margin-top:12px; padding:12px;">Tạo tài khoản ReviewNow</button>
    </form>

    <p class="muted text-center" style="margin-top:20px; font-size:13.5px;">
        Đã có tài khoản? <a asp-controller="Auth" asp-action="Login" style="color:var(--primary); font-weight:700;">Đăng nhập ngay</a>
    </p>
</div>
