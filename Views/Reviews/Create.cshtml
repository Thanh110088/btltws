@model ReviewFormViewModel
@{
    ViewData["Title"] = "Soạn thảo bài đánh giá";
}

<!-- Stepper Wizard -->
<div class="stepper">
    <div class="step-item completed">
        <span class="step-circle">✓</span>
        <span>1. Chọn sản phẩm</span>
    </div>
    <div class="step-divider" style="background:#16a34a;"></div>
    <div class="step-item active">
        <span class="step-circle">2</span>
        <span>Viết đánh giá & Chấm điểm</span>
    </div>
    <div class="step-divider"></div>
    <div class="step-item">
        <span class="step-circle">3</span>
        <span>Xuất bản</span>
    </div>
</div>

<!-- Main Form Card -->
<div class="form-card">
    <div class="form-header">
        <h1 class="form-title">Đánh giá sản phẩm</h1>
        <p class="form-subtitle">Chia sẻ trải nghiệm thực tế của bạn để giúp người tiêu dùng đưa ra quyết định mua sắm đúng đắn.</p>
    </div>

    <!-- Thông tin sản phẩm được chọn -->
    <div class="card pad" style="margin-bottom: 24px; background:#f8fafc; border:1px solid var(--border);">
        <span class="muted text-xs" style="text-transform:uppercase; font-weight:700; letter-spacing:0.5px;">Sản phẩm đánh giá</span>
        <h2 style="margin:4px 0 2px; color:var(--ink); font-size:18px;">@Model.ProductName</h2>
        @if (!string.IsNullOrEmpty(Model.ProductBrand))
        {
            <span class="muted text-sm">Thương hiệu: @Model.ProductBrand</span>
        }
    </div>

    <form class="form" asp-controller="Reviews" asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProductId" />
        <div asp-validation-summary="ModelOnly" class="panel" style="background:#fef2f2; color:#b91c1c; padding:12px; margin-bottom:16px; border-radius:10px;"></div>

        <!-- Đánh giá tổng quan (5 sao tương tác) -->
        <div class="form-group" style="margin-bottom: 22px;">
            <label class="form-label">
                Mức độ hài lòng: <strong id="ratingText" style="color:var(--primary); font-size:15px;">5.0 / 5.0 (Rất hài lòng)</strong>
            </label>
            <input type="hidden" asp-for="Rating" id="ratingInput" value="@Model.Rating" />
            
            <div class="star-rating-row" style="margin-top:6px;">
                <div class="stars-interactive" id="star-picker">
                    @for (int n = 1; n <= 5; n++)
                    {
                        <button type="button" class="star-btn @(n <= Model.Rating ? "on" : "")" data-val="@n" onclick="setRating(@n)" aria-label="@n sao">
                            <svg class="star on" style="width:32px; height:32px; fill:@(n <= Model.Rating ? "#f59e0b" : "#cbd5e1");" viewBox="0 0 20 20">
                                <path d="M10 1.8 12.4 7l5.6.5-4.2 3.7 1.3 5.5L10 14.2 4.9 16.7 6.2 11.2 2 7.5 7.6 7z" />
                            </svg>
                        </button>
                    }
                </div>
                <span class="muted text-sm">(Nhấp vào số sao để xếp hạng)</span>
            </div>
            <span asp-validation-for="Rating" style="color:var(--cons); font-size:12px;"></span>
        </div>

        <!-- Ưu điểm & Nhược điểm (Side-by-side) -->
        <div class="form-grid-2">
            <div class="form-group">
                <label class="form-label" style="color:var(--pros-dark);">
                    <span>Điểm hài lòng (Ưu điểm / Pros)</span> <span class="req">(*)</span>
                </label>
                <textarea class="form-control" asp-for="Pros" required minlength="10" rows="4" 
                          placeholder="Chia sẻ những điểm bạn thích, ưu điểm nổi bật khi trải nghiệm sản phẩm này..."
                          style="border-color:#bbf7d0; background:#f0fdf4;"></textarea>
                <span asp-validation-for="Pros" style="color:var(--cons); font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label" style="color:var(--cons-dark);">
                    <span>Hạn chế thực tế (Nhược điểm / Cons)</span> <span class="req">(*)</span>
                </label>
                <textarea class="form-control" asp-for="Cons" required minlength="10" rows="4" 
                          placeholder="Chia sẻ những điểm trừ, hạn chế hoặc khó chịu bạn gặp phải..."
                          style="border-color:#fecaca; background:#fef2f2;"></textarea>
                <span asp-validation-for="Cons" style="color:var(--cons); font-size:12px;"></span>
            </div>
        </div>

        <!-- Upload ảnh minh chứng -->
        <div class="form-group" style="margin: 20px 0;">
            <label class="form-label">Ảnh minh chứng sản phẩm (tùy chọn)</label>
            <div class="dropzone" onclick="document.getElementById('fileUploadInput').click()">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="1.8" style="margin-bottom:8px;">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                <div class="dropzone-title">Nhấp để chọn ảnh minh chứng thực tế</div>
                <div class="dropzone-sub">Hỗ trợ JPG, PNG, WEBP (tối đa 5MB / ảnh)</div>
                <input id="fileUploadInput" name="files" type="file" accept="image/*" multiple style="display:none;" onchange="previewFiles(this)" />
            </div>
            <div id="filePreviewList" class="row" style="gap:10px; margin-top:10px; flex-wrap:wrap;"></div>
        </div>

        <!-- Đăng ẩn danh -->
        <div class="row" style="margin: 16px 0;">
            <label class="filter-checkbox-label" style="font-size:13.5px; cursor:pointer;">
                <input type="checkbox" asp-for="IsAnonymous" />
                <span>Đăng bài ẩn danh (Tên tài khoản của bạn sẽ không hiển thị công khai)</span>
            </label>
        </div>

        <!-- Action Buttons -->
        <div class="row-between" style="margin-top: 24px; border-top:1px solid var(--border-light); padding-top:20px;">
            <a class="btn-ghost" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId">
                ✕ Hủy bỏ
            </a>

            <button class="btn" type="submit" style="padding: 12px 32px; font-size:15px;">
                Xuất bản đánh giá
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const ratingLabels = {
            1: "1.0 / 5.0 (Rất thất vọng)",
            2: "2.0 / 5.0 (Chưa hài lòng)",
            3: "3.0 / 5.0 (Tạm ổn)",
            4: "4.0 / 5.0 (Hài lòng)",
            5: "5.0 / 5.0 (Rất hài lòng)"
        };

        function setRating(val) {
            document.getElementById("ratingInput").value = val;
            const textEl = document.getElementById("ratingText");
            if (textEl && ratingLabels[val]) {
                textEl.textContent = ratingLabels[val];
            }

            const buttons = document.querySelectorAll("#star-picker .star-btn");
            buttons.forEach(btn => {
                const btnVal = Number(btn.dataset.val);
                const svg = btn.querySelector("svg");
                if (btnVal <= val) {
                    btn.classList.add("on");
                    svg.style.fill = "#f59e0b";
                } else {
                    btn.classList.remove("on");
                    svg.style.fill = "#cbd5e1";
                }
            });
        }

        function previewFiles(input) {
            const preview = document.getElementById("filePreviewList");
            preview.innerHTML = "";
            if (!input.files) return;
            Array.from(input.files).forEach(f => {
                const span = document.createElement("span");
                span.className = "badge";
                span.textContent = f.name;
                preview.appendChild(span);
            });
        }
    </script>
}
