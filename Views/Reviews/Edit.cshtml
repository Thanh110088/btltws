@model ReviewFormViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa đánh giá {Model.ProductName}";
}

<!-- Stepper Wizard -->
<div class="stepper">
    <div class="step-item completed">
        <span class="step-circle">✓</span>
        <span>1. Chọn sản phẩm</span>
    </div>
    <div class="step-divider" style="background:#16a34a;"></div>
    <div class="step-item active">
        <span class="step-circle">2</span>
        <span>Cập nhật đánh giá</span>
    </div>
    <div class="step-divider"></div>
    <div class="step-item">
        <span class="step-circle">3</span>
        <span>Lưu & Xuất bản</span>
    </div>
</div>

<div class="form-card">
    <div class="form-header">
        <h1 class="form-title">Chỉnh sửa bài đánh giá: @Model.ProductName</h1>
        <p class="form-subtitle">@Model.ProductBrand — Cập nhật điểm hài lòng và hạn chế thực tế để cộng đồng có thêm thông tin đa chiều.</p>
    </div>

    <form class="form" asp-controller="Reviews" asp-action="Edit" asp-route-id="@Model.ReviewId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProductId" />
        <input type="hidden" asp-for="ReviewId" />
        <div asp-validation-summary="ModelOnly" class="panel" style="background:#fef2f2; color:#b91c1c; padding:12px; margin-bottom:16px; border-radius:10px;"></div>

        <!-- Star Rating -->
        <div class="form-group" style="margin-bottom: 20px;">
            <label class="form-label">
                Đánh giá tổng quan: <strong id="ratingText" style="color:var(--primary); font-size:15px;">@Model.Rating.ToString("0.0") / 5.0</strong>
            </label>
            <input type="hidden" asp-for="Rating" id="ratingInput" />
            <div class="star-rating-row" style="margin-top:6px;">
                <div class="stars-interactive" id="star-picker">
                    @for (int n = 1; n <= 5; n++)
                    {
                        <button type="button" class="star-btn @(n <= Model.Rating ? "on" : "")" data-val="@n" onclick="setRating(@n)" aria-label="@n sao">
                            <svg class="star @(n <= Model.Rating ? "on" : "")" style="width:32px; height:32px; fill:@(n <= Model.Rating ? "#f59e0b" : "#cbd5e1");" viewBox="0 0 20 20">
                                <path d="M10 1.8 12.4 7l5.6.5-4.2 3.7 1.3 5.5L10 14.2 4.9 16.7 6.2 11.2 2 7.5 7.6 7z" />
                            </svg>
                        </button>
                    }
                </div>
                <span class="muted text-sm">(Nhấp chuột vào số sao để xếp hạng lại)</span>
            </div>
            <span asp-validation-for="Rating" style="color:var(--cons); font-size:12px;"></span>
        </div>

        <!-- Pros & Cons Grid -->
        <div class="form-grid-2">
            <div class="form-group">
                <label class="form-label" style="color:var(--pros-dark);">
                    <span>Điểm hài lòng (Pros)</span> <span class="req">(*)</span>
                </label>
                <textarea class="form-control" asp-for="Pros" required minlength="10" rows="4" 
                          style="border-color:#bbf7d0; background:#f0fdf4;"></textarea>
                <span asp-validation-for="Pros" style="color:var(--cons); font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label" style="color:var(--cons-dark);">
                    <span>Hạn chế thực tế (Cons)</span> <span class="req">(*)</span>
                </label>
                <textarea class="form-control" asp-for="Cons" required minlength="10" rows="4" 
                          style="border-color:#fecaca; background:#fef2f2;"></textarea>
                <span asp-validation-for="Cons" style="color:var(--cons); font-size:12px;"></span>
            </div>
        </div>

        <!-- Anonymous -->
        <div class="row" style="margin: 12px 0;">
            <label class="filter-checkbox-label">
                <input type="checkbox" asp-for="IsAnonymous" />
                <span>Đăng bài ẩn danh</span>
            </label>
        </div>

        <!-- Existing Images -->
        @if (Model.ExistingImageUrls != null && Model.ExistingImageUrls.Count > 0)
        {
            <div style="margin: 16px 0;">
                <label class="form-label">Ảnh minh chứng hiện tại</label>
                <div class="row" style="gap:10px; flex-wrap:wrap; margin-top:8px;" id="existingImagesList">
                    @for (int i = 0; i < Model.ExistingImageUrls.Count; i++)
                    {
                        var url = Model.ExistingImageUrls[i];
                        <div class="existing-img-card" style="position:relative; width:90px; height:90px; border-radius:8px; overflow:hidden; border:1px solid var(--border);">
                            <img src="@url" alt="Ảnh review" style="width:100%; height:100%; object-fit:cover;" />
                            <input type="hidden" name="ExistingImageUrls" value="@url" />
                            <button type="button" onclick="this.parentElement.remove()" 
                                    style="position:absolute; top:4px; right:4px; background:rgba(220,38,38,0.85); color:white; border:0; border-radius:50%; width:20px; height:20px; cursor:pointer; font-size:11px; display:flex; align-items:center; justify-content:center;">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Upload More Images -->
        <div class="form-group">
            <label class="form-label">Tải thêm ảnh minh chứng mới</label>
            <div class="dropzone" onclick="document.getElementById('fileUploadInput').click()">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="1.8" style="margin-bottom:6px;">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                <div class="dropzone-title">Nhấp vào đây để chọn thêm ảnh từ thiết bị</div>
                <div class="dropzone-sub">Định dạng JPG, PNG (tối đa thêm 6 ảnh)</div>
                <input id="fileUploadInput" name="files" type="file" accept="image/*" multiple style="display:none;" />
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row-between" style="margin-top: 24px; border-top:1px solid var(--border-light); padding-top:20px;">
            <a class="btn-ghost" asp-controller="Reviews" asp-action="Mine">
                Hủy thay đổi
            </a>
            <button class="btn" type="submit" style="padding:12px 28px;">
                Lưu bài đánh giá
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function setRating(val) {
            document.getElementById("ratingInput").value = val;
            const textEl = document.getElementById("ratingText");
            if (textEl) {
                textEl.textContent = val + ".0 / 5.0";
            }
            const buttons = document.querySelectorAll("#star-picker .star-btn");
            buttons.forEach(btn => {
                const btnVal = Number(btn.dataset.val);
                const svg = btn.querySelector("svg");
                if (btnVal <= val) {
                    btn.classList.add("on");
                    svg.style.fill = "#f59e0b";
                } else {
                    btn.classList.remove("on");
                    svg.style.fill = "#cbd5e1";
                }
            });
        }
    </script>
}
