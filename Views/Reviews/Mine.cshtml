@model PagedResult<ReviewDto>
@{
    ViewData["Title"] = "Bài đánh giá của tôi";
}

<div class="section-head row" style="justify-content:space-between; align-items:center; margin-bottom:20px;">
    <div>
        <p class="kicker">Quản lý bài viết</p>
        <h1 style="margin:4px 0 0 0;">Bài đánh giá của tôi</h1>
    </div>
    <a class="btn" asp-controller="Reviews" asp-action="Create">Viết đánh giá mới</a>
</div>

@if (Model.Items.Count > 0)
{
    <div class="stack" style="gap:16px;">
        @foreach (var review in Model.Items)
        {
            <partial name="_ReviewCard" model="review" />
        }
    </div>
    <partial name="_Pager" model="(Model.Page, Model.TotalPages)" />
}
else
{
    <div class="panel empty pad" style="text-align:center; padding:48px 16px;">
        <h3 style="margin-bottom:8px;">Bạn chưa có bài đánh giá nào.</h3>
        <p class="muted" style="margin-bottom:20px;">Hãy chia sẻ trải nghiệm thực tế với các ưu điểm và hạn chế để giúp cộng đồng mua sắm thông thái hơn!</p>
        <a class="btn" asp-controller="Reviews" asp-action="Create">Bắt đầu viết đánh giá</a>
    </div>
}
