@model ProductPickerViewModel
@{
    ViewData["Title"] = "Chọn sản phẩm để đánh giá";
}

<section class="auth-card" style="max-width:760px; margin:20px auto;">
    <p class="kicker">Viết đánh giá</p>
    <h1>Chọn sản phẩm</h1>
    <p class="muted">Chọn sản phẩm đã có trong danh mục hoặc thêm sản phẩm mới để bắt đầu bóc tách Pros & Cons.</p>

    <!-- Search Form -->
    <form class="search" asp-controller="Reviews" asp-action="Create" method="get" style="max-width:none; margin:16px 0;">
        <input name="keyword" value="@Model.Keyword" placeholder="Tìm sản phẩm để đánh giá..." aria-label="Tìm sản phẩm" />
        <button type="submit">Tìm</button>
    </form>

    <div class="row" style="justify-content:space-between; align-items:center; margin-bottom:16px;">
        <span class="muted">Không tìm thấy sản phẩm bạn muốn review?</span>
        <a class="btn-soft" asp-controller="Products" asp-action="Create" asp-route-name="@Model.Keyword">
            + Thêm sản phẩm mới
        </a>
    </div>

    <!-- Product Pick List -->
    @if (Model.Products.Items.Count > 0)
    {
        <div class="stack" style="gap:10px;">
            @foreach (var p in Model.Products.Items)
            {
                <a class="card pad row pick" asp-controller="Reviews" asp-action="Create" asp-route-productId="@p.Id"
                   style="text-decoration:none; color:inherit; justify-content:space-between; align-items:center; transition:background 0.2s;">
                    <div>
                        <strong style="font-size:16px; display:block; color:var(--text);">@p.Name</strong>
                        <span class="muted" style="font-size:13px;">@p.Brand · @p.CategoryName · @p.Price.ToString("N0") ₫</span>
                    </div>
                    <span class="btn-ghost" style="pointer-events:none;">Chọn ›</span>
                </a>
            }
        </div>
        <partial name="_Pager" model="(Model.Products.Page, Model.Products.TotalPages)" />
    }
    else
    {
        <div class="panel empty pad" style="text-align:center; padding:32px;">
            <p>Chưa có sản phẩm nào khớp với từ khóa "@Model.Keyword".</p>
            <a class="btn" asp-controller="Products" asp-action="Create" asp-route-name="@Model.Keyword">
                Thêm sản phẩm "@Model.Keyword" ngay
            </a>
        </div>
    }
</section>
