                    <span>Bài viết nổi bật</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
            </div>
        </div>

        <!-- Category Nav Bar -->
        <div class="category-navbar">
            <div class="nav-pills">
                @{
                    var currentPath = Context.Request.Path.Value ?? "/";
                    var currentCatId = Context.Request.Query["categoryId"].ToString();
                    var isHome = string.IsNullOrEmpty(currentCatId) && (currentPath == "/" || currentPath.Equals("/Products", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/Products/Index", StringComparison.OrdinalIgnoreCase));
                }
                <a class="nav-pill @(isHome && !Context.Request.Query.ContainsKey("keyword") ? "active" : "")" asp-controller="Products" asp-action="Index">Tất cả</a>
                @foreach (var cat in layoutCategories)
                {
                    var isActive = currentCatId == cat.Id.ToString();
                    <a class="nav-pill @(isActive ? "active" : "")" asp-controller="Products" asp-action="Index" asp-route-categoryId="@cat.Id">@cat.Name</a>
                }
            </div>

            <a class="nav-write-btn" asp-controller="Reviews" asp-action="Create">
                <span>+ Viết Đánh Giá</span>
            </a>
        </div>
    </header>

    <!-- Main Content Body -->
    <main id="main" class="wrap">
