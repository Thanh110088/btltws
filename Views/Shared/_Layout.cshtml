                                <span>⚡ Quản trị</span>
                            </a>
                        }
                        <a class="user-profile-btn" asp-controller="Reviews" asp-action="Mine" title="@nameClaim (Quản lý bài viết)">
                            <span>@initial</span>
                        </a>
                        <a class="btn-ghost" asp-controller="Auth" asp-action="Logout" style="padding:4px 10px; font-size:12px; border-radius:999px; background:rgba(255,255,255,0.2); color:white; border:0;">Đăng xuất</a>
                    }
                    else
                    {
