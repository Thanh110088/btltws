    <!-- Global Toast & Modal Container -->
    <div id="toast" class="toast" hidden></div>
    <div id="modal" hidden></div>

    <script>
        function showToast(message) {
            const toast = document.getElementById("toast");
            if (!toast) return;
            toast.textContent = message;
            toast.hidden = false;
            toast.classList.add("on");
            clearTimeout(window.__toastTimer);
            window.__toastTimer = setTimeout(() => {
                toast.classList.remove("on");
                toast.hidden = true;
            }, 3000);
        }

        function openModal(contentHtml) {
            const modal = document.getElementById("modal");
            if (!modal) return;
            modal.innerHTML = `<div class="modal-back"><div class="modal-card">${contentHtml}</div></div>`;
            modal.hidden = false;
        }

        function closeModal() {
            const modal = document.getElementById("modal");
            if (!modal) return;
            modal.hidden = true;
            modal.innerHTML = "";
        }

        document.addEventListener("click", function(e) {
            if (e.target.classList.contains("modal-back") || e.target.closest("[data-action='close-modal']")) {
                closeModal();
            }
        });

        async function handleVote(reviewId, voteType, button) {
            try {
                const response = await fetch("/Social/Vote", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: `reviewId=${reviewId}&voteType=${voteType}`
                });
                if (response.status === 401) {
                    window.location.href = `/Auth/Login?returnUrl=${encodeURIComponent(window.location.pathname)}`;
                    return;
                }
                const data = await response.json();
                const card = button.closest(".card") || button.closest("article") || button.closest(".review-item-horizontal");
                if (card) {
                    const upEl = card.querySelector(`[data-up="${reviewId}"]`);
                    const downEl = card.querySelector(`[data-down="${reviewId}"]`);
                    if (upEl) upEl.textContent = data.upvoteCount;
                    if (downEl) downEl.textContent = data.downvoteCount;
                }
                showToast(data.currentVote ? (data.currentVote === "Up" ? "Đã ghi nhận hữu ích" : "Đã ghi nhận không hữu ích") : "Đã gỡ vote");
            } catch (err) {
                console.error(err);
            }
        }

        async function handleBookmark(reviewId, button) {
            const isBookmarked = button.classList.contains("on");
            try {
                const response = await fetch("/Social/Bookmark", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: `reviewId=${reviewId}&remove=${isBookmarked}`
                });
                if (response.status === 401) {
                    window.location.href = `/Auth/Login?returnUrl=${encodeURIComponent(window.location.pathname)}`;
                    return;
                }
                const data = await response.json();
                if (data.bookmarked) {
                    button.classList.add("on");
                    button.textContent = "Đã lưu";
                    showToast("Đã lưu bài viết");
                } else {
                    button.classList.remove("on");
                    button.textContent = "Lưu";
                    showToast("Đã bỏ lưu bài viết");
                }
            } catch (err) {
                console.error(err);
            }
        }

        function copyShareLink(url) {
            navigator.clipboard.writeText(url).then(() => {
                showToast("Đã chép link chia sẻ!");
            }).catch(() => {
                showToast(url);
            });
        }

        /* ----------------------------------------------------------------------
           COMMENTING SYSTEM CLIENT LOGIC
           ---------------------------------------------------------------------- */
        window.__currentUserId = @currentUserId;
        window.__isAdmin = @(isAdmin ? "true" : "false");
        window.__isAuthenticated = @(isAuthenticated ? "true" : "false");

        const loadedComments = {};

        async function toggleComments(reviewId, btn) {
            const box = document.getElementById(`comments-box-${reviewId}`);
            if (!box) return;

            const isHidden = box.style.display === "none" || !box.style.display;
            if (isHidden) {
                box.style.display = "block";
                if (btn) btn.classList.add("active");
                if (!loadedComments[reviewId]) {
                    await loadComments(reviewId);
                }
            } else {
                box.style.display = "none";
                if (btn) btn.classList.remove("active");
            }
        }

        async function loadComments(reviewId) {
            const list = document.getElementById(`comments-list-${reviewId}`);
            if (!list) return;

            list.innerHTML = `<div class="muted text-xs" style="padding:12px 0; text-align:center;">Đang tải bình luận...</div>`;

            try {
                const res = await fetch(`/Social/Comments/${reviewId}`);
                if (!res.ok) throw new Error("Không thể tải bình luận");
                const data = await res.json();
                loadedComments[reviewId] = true;

                renderCommentList(reviewId, data.items || []);
            } catch (err) {
                list.innerHTML = `<div class="text-xs" style="color:var(--cons); padding:10px 0; text-align:center;">Không thể tải bình luận. Vui lòng thử lại sau.</div>`;
            }
        }

        function renderCommentList(reviewId, items) {
            const list = document.getElementById(`comments-list-${reviewId}`);
            if (!list) return;

            if (!items || items.length === 0) {
                list.innerHTML = `<div class="muted text-xs" style="padding:14px 0; text-align:center;">Chưa có bình luận nào. Hãy là người đầu tiên thảo luận về bài review này!</div>`;
                return;
            }

            list.innerHTML = items.map(c => renderCommentItem(c)).join("");
        }

        function renderCommentItem(c) {
            const authorName = escapeHtml(c.authorName || "Người dùng");
            const initial = authorName.charAt(0).toUpperCase();
            const dateStr = formatDateTime(c.createdAt);
            const content = escapeHtml(c.content || "");
            const isAnon = c.isAnonymous;
            const authorLink = (!isAnon && c.authorId)
                ? `<a href="/Social/UserProfile/${c.authorId}" class="comment-author">${authorName}</a>`
                : `<span class="comment-author">${authorName}</span>`;

            const canDelete = (window.__isAuthenticated && window.__currentUserId && c.authorId === window.__currentUserId) || window.__isAdmin;
            const deleteBtn = canDelete ? `<button type="button" class="comment-delete-btn" onclick="handleDeleteComment(${c.id}, ${c.reviewId}, this)" title="Xóa bình luận">✕ Xóa</button>` : '';

            return `
                <div class="comment-item" id="comment-item-${c.id}">
                    <span class="comment-avatar">
                        ${initial}
                    </span>
                    <div class="comment-body">
                        <div class="comment-header">
                            ${authorLink}
                            ${isAnon ? '<span class="badge" style="font-size:10px; padding:1px 6px;">Ẩn danh</span>' : ''}
                            <span class="comment-time">• ${dateStr}</span>
                            ${deleteBtn}
                        </div>
                        <div class="comment-content">${content}</div>
                    </div>
                </div>
            `;
        }

        async function handleDeleteComment(commentId, reviewId, btn) {
            if (!confirm("Bạn có chắc chắn muốn xóa bình luận này?")) return;

            try {
                const res = await fetch(`/Social/DeleteComment/${commentId}`, {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (res.status === 401) {
                    window.location.href = `/Auth/Login?returnUrl=${encodeURIComponent(window.location.pathname)}`;
                    return;
                }

                const data = await res.json();
                if (data.success) {
                    const itemEl = document.getElementById(`comment-item-${commentId}`);
                    if (itemEl) itemEl.remove();

                    // Decrement badge count
                    const countEl = document.getElementById(`comment-count-${reviewId}`);
                    if (countEl) {
                        const cur = Math.max(0, (parseInt(countEl.textContent, 10) || 0) - 1);
                        countEl.textContent = cur;
                    }
                    const headingCountEl = document.getElementById(`comment-heading-count-${reviewId}`);
                    if (headingCountEl) {
                        const cur = Math.max(0, (parseInt(headingCountEl.textContent, 10) || 0) - 1);
                        headingCountEl.textContent = cur;
                    }

                    const list = document.getElementById(`comments-list-${reviewId}`);
                    if (list && list.children.length === 0) {
                        list.innerHTML = `<div class="muted text-xs" style="padding:14px 0; text-align:center;">Chưa có bình luận nào. Hãy là người đầu tiên thảo luận về bài review này!</div>`;
                    }

                    showToast("Đã xóa bình luận!");
                }
            } catch (err) {
                console.error(err);
                showToast("Không thể xóa bình luận. Vui lòng thử lại!");
            }
        }

        async function submitComment(event, reviewId) {
            event.preventDefault();
            const form = event.target;
            const input = document.getElementById(`comment-input-${reviewId}`);
            const anonInput = document.getElementById(`comment-anon-${reviewId}`);
            const submitBtn = document.getElementById(`comment-submit-${reviewId}`);
            if (!input || !input.value.trim()) return;

            const content = input.value.trim();
            const isAnonymous = anonInput ? anonInput.checked : false;

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = "Đang gửi...";
            }

            try {
                const formData = new URLSearchParams();
                formData.append("reviewId", reviewId);
                formData.append("Content", content);
                formData.append("IsAnonymous", isAnonymous);

                const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) {
                    formData.append("__RequestVerificationToken", tokenInput.value);
                }

                const res = await fetch("/Social/Comment", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: formData.toString()
                });

                if (res.status === 401) {
                    window.location.href = `/Auth/Login?returnUrl=${encodeURIComponent(window.location.pathname)}`;
                    return;
                }

                if (!res.ok) {
                    const errText = await res.text();
                    throw new Error("Lỗi gửi bình luận: " + errText);
                }

                const data = await res.json();
                if (data.success && data.comment) {
                    input.value = "";
                    if (anonInput) anonInput.checked = false;

                    const list = document.getElementById(`comments-list-${reviewId}`);
                    if (list) {
                        if (list.innerHTML.includes("Chưa có bình luận nào")) {
                            list.innerHTML = "";
                        }
                        list.insertAdjacentHTML("beforeend", renderCommentItem(data.comment));
                    }

                    const countEl = document.getElementById(`comment-count-${reviewId}`);
                    if (countEl) {
                        const currentCount = parseInt(countEl.textContent, 10) || 0;
                        countEl.textContent = currentCount + 1;
                    }
                    const headingCountEl = document.getElementById(`comment-heading-count-${reviewId}`);
                    if (headingCountEl) {
                        const currentCount = parseInt(headingCountEl.textContent, 10) || 0;
                        headingCountEl.textContent = currentCount + 1;
                    }

                    showToast("Đã gửi bình luận thành công!");
                }
            } catch (err) {
                console.error(err);
                showToast("Không thể gửi bình luận. Vui lòng thử lại!");
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Gửi bình luận";
                }
            }
        }

        function formatDateTime(isoString) {
            if (!isoString) return "";
            try {
                const d = new Date(isoString);
                return d.toLocaleDateString("vi-VN", { hour: "2-digit", minute: "2-digit", day: "2-digit", month: "2-digit", year: "numeric" });
            } catch {
                return isoString;
            }
        }

        function escapeHtml(str) {
            if (!str) return "";
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[tag] || tag));
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
