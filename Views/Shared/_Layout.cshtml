                <span>@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="panel" style="background:#fef2f2; border-left:4px solid #dc2626; padding:12px 18px; margin-bottom:20px; border-radius:10px; color:#b91c1c; font-weight:600; display:flex; align-items:center; gap:8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                <span>@TempData["Error"]</span>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="panel" style="background:#f0f9ff; border-left:4px solid #0284c7; padding:12px 18px; margin-bottom:20px; border-radius:10px; color:#0369a1; font-weight:600; display:flex; align-items:center; gap:8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                <span>@TempData["Info"]</span>
            </div>
        }

        @RenderBody()
    </main>

