@model ProductListItemDto
@{
    var hues = new[] { "#0e7c74", "#b7791f", "#c2410c", "#3f6212", "#1d4ed8", "#7c3aed" };
    var firstChar = !string.IsNullOrWhiteSpace(Model.Name) ? Model.Name.Trim()[0] : '?';
    var hue = hues[Math.Abs(firstChar) % hues.Length];
    var roundedRating = (int)Math.Round(Model.AvgRating);
}

<article class="card product">
    <a class="cover" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">
        <div class="thumb" style="@(string.IsNullOrEmpty(Model.ImageUrl) ? $"background:{hue}" : "")">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            }
            else
            {
                <span>@char.ToUpper(firstChar)</span>
            }
        </div>
        <div class="product-body">
            <p class="kicker">@Model.Brand · @Model.CategoryName</p>
            <h3>@Model.Name</h3>
            <p class="price">@Model.Price.ToString("N0") ₫</p>
            <p class="meta">
                <span class="stars" aria-label="@Model.AvgRating trên 5 sao">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <svg class="star @(i <= roundedRating ? "on" : "")" viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M10 1.8 12.4 7l5.6.5-4.2 3.7 1.3 5.5L10 14.2 4.9 16.7 6.2 11.2 2 7.5 7.6 7z" />
                        </svg>
                    }
                </span>
                <span>@Model.AvgRating.ToString("0.0") · @Model.TotalReviews review</span>
            </p>
        </div>
    </a>
    <a class="btn write-link" asp-controller="Reviews" asp-action="Create" asp-route-productId="@Model.Id">Viết đánh giá</a>
</article>
