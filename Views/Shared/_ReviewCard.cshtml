@model ReviewDto
@{
    var currentUserId = 0;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    if (isAuthenticated)
    {
        int.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out currentUserId);
    }
    var isAuthor = isAuthenticated && Model.AuthorId.HasValue && Model.AuthorId.Value == currentUserId;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var shareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Products/Details/{Model.ProductId}#review-{Model.Id}";
}

<article class="review card" id="review-@Model.Id" style="padding:18px; margin-bottom:16px;">
    <div class="review-top row" style="justify-content:space-between; align-items:center;">
        <div class="row" style="gap:10px; align-items:center;">
            <span class="stars" aria-label="@Model.Rating trên 5 sao">
                @for (int i = 1; i <= 5; i++)
                {
                    <svg class="star @(i <= Model.Rating ? "on" : "")" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M10 1.8 12.4 7l5.6.5-4.2 3.7 1.3 5.5L10 14.2 4.9 16.7 6.2 11.2 2 7.5 7.6 7z" />
                    </svg>
                }
            </span>

            @if (Model.AuthorId.HasValue && !Model.IsAnonymous)
            {
                <a class="who" asp-controller="Social" asp-action="UserProfile" asp-route-id="@Model.AuthorId.Value" style="font-weight:600; color:inherit; text-decoration:none;">
                    @Model.AuthorName
                </a>
            }
            else
            {
                <span class="who" style="font-weight:600;">@Model.AuthorName</span>
            }

            @if (Model.IsAnonymous)
            {
                <span class="badge">Ẩn danh</span>
            }
            @if (Model.IsHidden)
            {
                <span class="badge warn">Đã bị ẩn</span>
            }
        </div>
        <span class="muted" style="font-size:13px;">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.ProductName))
    {
        <p class="muted" style="margin:6px 0 0; font-size:13px;">
            Sản phẩm: <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" style="color:inherit; font-weight:500;">@Model.ProductName</a>
        </p>
    }

    <div class="split" style="margin-top:12px;">
        <div class="box pros">
            <h4>Điểm hài lòng (Pros)</h4>
            <p>@Model.Pros</p>
        </div>
        <div class="box cons">
            <h4>Hạn chế thực tế (Cons)</h4>
            <p>@Model.Cons</p>
        </div>
    </div>

    @if (Model.ImageUrls != null && Model.ImageUrls.Count > 0)
    {
        <div class="thumbs" style="margin-top:12px;">
            @foreach (var img in Model.ImageUrls)
            {
                <a href="@img" target="_blank" rel="noopener noreferrer">
                    <img src="@img" alt="Ảnh minh chứng" style="max-height:90px; border-radius:6px; object-fit:cover;" />
                </a>
            }
        </div>
    }

    <div class="actions row" style="margin-top:14px; gap:8px; flex-wrap:wrap; align-items:center;">
        <button type="button" class="btn-soft" onclick="handleVote(@Model.Id, 'Up', this)" style="font-size:13px; padding:6px 12px;">
            👍 Hữu ích <span data-up="@Model.Id" style="font-weight:bold; margin-left:4px;">@Model.UpvoteCount</span>
        </button>
        <button type="button" class="btn-soft" onclick="handleVote(@Model.Id, 'Down', this)" style="font-size:13px; padding:6px 12px;">
            👎 Không <span data-down="@Model.Id" style="font-weight:bold; margin-left:4px;">@Model.DownvoteCount</span>
        </button>
        <button type="button" class="btn-soft" onclick="toggleComments(@Model.Id, this)" style="font-size:13px; padding:6px 12px;">
            💬 Bình luận <span style="font-weight:bold; margin-left:4px;">@Model.CommentCount</span>
        </button>
        <button type="button" class="btn-soft" onclick="handleBookmark(@Model.Id, this)" style="font-size:13px; padding:6px 12px;">
            🔖 Lưu
        </button>
        <button type="button" class="btn-soft" onclick="copyShareLink('@shareUrl')" style="font-size:13px; padding:6px 12px;">
            🔗 Chia sẻ
        </button>
        <button type="button" class="btn-soft" onclick="openReportModal(@Model.Id)" style="font-size:13px; padding:6px 12px;">
            🚩 Báo cáo
        </button>

        @if (isAuthor || isAdmin)
        {
            <div class="row" style="margin-left:auto; gap:6px;">
                <a class="btn-soft" asp-controller="Reviews" asp-action="Edit" asp-route-id="@Model.Id" style="font-size:13px; padding:6px 12px; text-decoration:none;">Sửa</a>
                <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài review này?');" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button class="btn-danger" type="submit" style="font-size:13px; padding:6px 12px;">Xóa</button>
                </form>
            </div>
        }
    </div>
</article>
